# Krishi Intelligence Environment Configuration
# Google Gemini API Key (Mandatory for live Gemini generation, otherwise high-fidelity AI DEMO mode activates automatically)
GOOGLE_GEMINI_API_KEY=optional_gemini_api_key

# Port for Backend Express API (Default: 3001)
PORT=3001

# Frontend Port (Default: 5173)
VITE_API_URL=http://localhost:3001
